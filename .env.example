GOOGLE_MAPS_API_KEY=
BAKEDBOSTON_BASE_URL=https://www.baked-boston.com
OPTIMIZER_API_KEY=

# Production Gurobi Web License Service credentials. Configure all three.
GUROBI_WLSACCESSID=
GUROBI_WLSSECRET=
GUROBI_LICENSEID=
GUROBI_TIME_LIMIT_SECONDS=20

# Local development only. Keep false in every deployed environment.
ALLOW_NON_GUROBI_DEVELOPMENT_FALLBACK=false
